<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.seneca.workshop2.controller.SummaryController"
            prefWidth="1000" prefHeight="640"
            stylesheets="@../css/styles.css">

    <top>
        <VBox>
            <HBox styleClass="header" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Summary" styleClass="app-title"/>
                    <Label text="View saved vehicles, maintenance records and usage logs" styleClass="app-subtitle"/>
                </VBox>
            </HBox>

            <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="12">
                <Label text="Data type:" styleClass="field-label"/>
                <ComboBox fx:id="dataTypeComboBox" prefWidth="170" onAction="#onDataTypeChanged"/>
                <Label text="Vehicle:" styleClass="field-label"/>
                <ComboBox fx:id="vehicleComboBox" prefWidth="260" promptText="Select a vehicle"
                          onAction="#onVehicleChanged"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane styleClass="content">

            <TableView fx:id="vehicleTable">
                <columns>
                    <TableColumn fx:id="makeColumn" text="Make"/>
                    <TableColumn fx:id="modelColumn" text="Model"/>
                    <TableColumn fx:id="yearColumn" text="Year"/>
                    <TableColumn fx:id="typeColumn" text="Type"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No vehicles added yet"/>
                </placeholder>
            </TableView>

            <TableView fx:id="maintenanceTable" visible="false">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date"/>
                    <TableColumn fx:id="descriptionColumn" text="Description"/>
                    <TableColumn fx:id="costColumn" text="Cost"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No maintenance records for this vehicle"/>
                </placeholder>
            </TableView>

            <TableView fx:id="usageTable" visible="false">
                <columns>
                    <TableColumn fx:id="startDateColumn" text="Start Date"/>
                    <TableColumn fx:id="endDateColumn" text="End Date"/>
                    <TableColumn fx:id="distanceColumn" text="Kilometers"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No usage logs for this vehicle"/>
                </placeholder>
            </TableView>

        </StackPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="summaryLabel" styleClass="field-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Close" styleClass="secondary-button" onAction="#onClose"/>
        </HBox>
    </bottom>
</BorderPane>
